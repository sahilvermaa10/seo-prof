# Copy this file to .env and fill in your keys
# IMPORTANT: No spaces around =, no quotes around values

GEMINI_API_KEY=your_gemini_api_key_here

# Optional AI fallback — used automatically when Gemini is unavailable or fails
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SERPAPI_KEY=your_serpapi_key_here

# Optional settings
# PORT=3000
# GEMINI_MODEL=gemini-3.5-flash-lite   # default used by the server if unset
# SERPAPI_COUNTRY=us
# SERPAPI_LANGUAGE=en

# Page Speed Insights (Google Cloud Console — free, no billing needed)
PAGESPEED_API_KEY=

# OpenPageRank (openpagerank.com — free 2000/day)
OPENPR_API_KEY=

# Google Trends — NO KEY NEEDED (uses npm google-trends-api)

# Python FastAPI SEO Engine URL
# Local development defaults to http://localhost:8000, so this can stay unset.
# For a separate deployed Python service, set:
# PYTHON_ENGINE_URL=https://your-python-seo-engine.onrender.com

# PostgreSQL
# Local example: postgresql://postgres:postgres@localhost:5432/seo_agent
DATABASE_URL=
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Security & reliability (all optional — sensible defaults are built in)
# ---------------------------------------------------------------------------
# NODE_ENV=production   # set on your host; enables HSTS + TLS to the database

# Reverse proxies between the internet and Node (Render/Heroku/nginx = 1).
# Use TRUST_PROXY=false if Node is exposed directly with NO proxy in front, otherwise
# clients could spoof their IP to dodge rate limits.
# TRUST_PROXY=1

# Shared secret between Node and a SEPARATELY DEPLOYED Python engine. Set the same
# random value on both services (e.g. `openssl rand -hex 32`). Leave unset for local dev.
# ENGINE_SHARED_SECRET=

# Rate limits (per client IP, per 10 minutes unless noted)
# RATE_LIMIT_MAX_REQUESTS=30          # AI-heavy routes
# ENGINE_RATE_LIMIT_MAX_REQUESTS=120  # crawl / rank / keyword routes
# SIGNUP_RATE_LIMIT_MAX=10            # per hour
# LOGIN_MAX_FAILS_PER_IP=20           # per 15 minutes
# LOGIN_MAX_FAILS_PER_ACCOUNT_IP=8    # per 15 minutes

# AI provider timeout (ms) and request body limit
# AI_TIMEOUT_MS=60000
# JSON_BODY_LIMIT=8mb

# PASSWORD_RESET_RATE_LIMIT_MAX=8

# Sessions expire after 30 days; expired rows are purged after this many extra days
# SESSION_RETENTION_DAYS=90

# Database TLS: DB_SSL=false for a local/private DB; DB_SSL_REJECT_UNAUTHORIZED=true to verify certs
# DB_SSL=
# DB_SSL_REJECT_UNAUTHORIZED=
# DB_STATEMENT_TIMEOUT_MS=30000

# Python engine: max bytes downloaded per page (default 5 MB)
# ENGINE_MAX_BODY_BYTES=5242880

# ---- Billing (free trials + Pro) ----
# FREE_TRIALS=5                 # free runs per tool group per user
# PRICE_MONTHLY_INR=99
# PRICE_YEARLY_INR=4999
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Grant Pro manually: UPDATE users SET plan='pro_monthly', plan_expires_at=NOW()+INTERVAL '30 days' WHERE email='x@y.com';
